# ============================================================================
# AquiSense AI — Environment Configuration Template
# Instructions: Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to GitHub or publicly expose SUPABASE_SECRET_KEY.
# ============================================================================

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for backend server-to-database access
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Security / Authorization
# Optional API key required for write endpoints (/api/db/* write methods)
# If left empty in development, writes will be permitted for local testing.
API_AUTH_KEY=aquisense-secure-telemetry-key-2026

# Allowed Frontend Origins (Comma-separated for CORS)
FRONTEND_ORIGINS=https://aquisense-ai.vercel.app,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Server Host and Port
HOST=0.0.0.0
PORT=8000
